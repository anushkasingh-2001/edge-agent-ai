# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store

# Electron build output (main + preload compiled by `pnpm build:electron`)
electron/dist/

# PyInstaller scanner binaries — built per-host by `pnpm build:scanner`
# and dropped here for the desktop launcher to spawn. Not committed:
# each developer / CI matrix machine produces its own slot.
electron/resources/scanner-bin/

# PyInstaller intermediate artefacts inside scanner/
scanner/build/
scanner/dist/
scanner/*.spec.bak

# electron-builder output (.dmg / .zip / mac-arm64/Edge Agent AI.app)
release/

# Policy-gate artefacts — regenerated on every commit by the .githooks/pre-commit
# hook (`pnpm policy-gate`). Tracking them in git creates an infinite "modified
# after commit" loop: the hook overwrites them post-stage, so the next git status
# sees them dirty again. They're per-commit transient state, not source.
# (CI uploads them as artifacts; that's the canonical archive.)
edge-agent-output/

# ---------------------------------------------------------------------------
# Python bytecode + virtualenv (scanner)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
scanner/.venv/

# pip install -e regenerates this metadata on every install; tracking it
# causes endless "modified" churn after a `pip install -e .`.
scanner/src/*.egg-info/
scanner/src/edge_agent_scanner.egg-info/

# ---------------------------------------------------------------------------
# Cache + transient scanner state
# ---------------------------------------------------------------------------
# Per-repo scan cache populated by the optional ir_cache helper. Always
# regenerated; never source.
.edgeagent/cache/

# ---------------------------------------------------------------------------
# TypeScript incremental build info
# ---------------------------------------------------------------------------
# `tsc --build` writes this on every successful typecheck; it is a per-machine
# artifact and not a source file.
tsconfig.tsbuildinfo

# ---------------------------------------------------------------------------
# new_changes/ staging area
# ---------------------------------------------------------------------------
# The `new_changes/` directory is a reference implementation that has been
# merged into the real repo paths (scanner/, lib/, components/, app/api/).
# It is intentionally left on-disk locally as a quick reference but must not
# be committed: production code must not depend on it, and the
# README_APPLY/DELETE_AFTER_MIGRATION docs inside it are migration notes,
# not user-facing docs.
new_changes/
.vercel
