{
  "name": "edge-agent-ai",
  "version": "0.1.0",
  "description": "Static security and workflow scanner for AI agent repositories — desktop edition.",
  "author": "Anushka Singh <singh434@wisc.edu>",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "build:standalone": "next build && node scripts/copy-standalone-assets.mjs",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:scanner": "node scripts/build-scanner.mjs",
    "dev:electron": "cross-env EDGE_AGENT_DESKTOP=1 ELECTRON_RENDERER_URL=http://localhost:3000 concurrently -k -n web,elec -c blue,green \"next dev\" \"wait-on tcp:3000 && tsc -p electron/tsconfig.json && electron electron/dist/main.js\"",
    "start:electron-prod": "cross-env ELECTRON_RUN_AS_NODE= EDGE_AGENT_DESKTOP=1 electron electron/dist/main.js",
    "package:mac": "pnpm build:standalone && pnpm build:scanner && pnpm build:electron && node scripts/check-scanner-bin.mjs --platform=darwin --arch=arm64 && electron-builder --mac -c electron-builder.yml --publish=never",
    "package:win": "pnpm build:standalone && pnpm build:electron && node scripts/check-scanner-bin.mjs --platform=win32 --arch=x64 && electron-builder --win -c electron-builder.yml --publish=never",
    "package:linux": "pnpm build:standalone && pnpm build:electron && node scripts/check-scanner-bin.mjs --platform=linux --arch=x64 && electron-builder --linux -c electron-builder.yml --publish=never",
    "app:build": "pnpm build && pnpm build:electron",
    "app:start": "node scripts/app-preview.mjs",
    "app:preview": "pnpm app:build && pnpm app:start",
    "start": "next start",
    "lint": "eslint .",
    "policy-gate": "tsx scripts/policy-gate.ts",
    "policy-gate-setup": "tsx scripts/policy-gate-setup.ts",
    "test:explain": "tsx --test tests/finding-explain.test.ts",
    "test:workspace": "tsx --test tests/workspace-api.test.ts",
    "test:workspace-store": "tsx --test tests/workspace-store.test.ts",
    "test:modes": "tsx --test tests/intelligence-modes.test.ts",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@uiw/react-codemirror": "^4.25.10",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "^0.564.0",
    "mermaid": "^11.15.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-day-picker": "9.13.2",
    "react-dom": "^19",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "yaml": "^2.8.4",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "wait-on": "^9.0.10"
  }
}